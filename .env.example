APP_NAME=apant_be
PORT=8000
APP_ENV=development

# Persistence backend for all repositories. Per-component overrides below
# (AUTH_STORAGE / SCAN_STORAGE / REPORT_STORAGE) default to this when unset.
# Use "memory" only for tests / running without a database.
STORAGE=postgres

# OpenAI/Anthropic keys below are the LEGACY source. On first migration they are
# seeded into the DB-managed llm_providers table; afterwards providers/models are
# managed via the admin LLM menu. Kept as bootstrap fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Master key that encrypts LLM provider API keys at rest (AES-256-GCM).
# Required when STORAGE=postgres. Generate 32 random bytes as hex:
#   openssl rand -hex 32
LLM_ENCRYPTION_KEY=

# Bootstrap admin, seeded once if no admin exists. Change the password after
# first login. Defaults: admin / admin@apant.local / ChangeMe123!
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@apant.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=
# Access token lifetime in MINUTES (short-lived; refreshed silently). Best practice: 15.
AUTH_ACCESS_TOKEN_TTL_MINUTES=30
# Refresh token sliding lifetime in hours (idle timeout). 168 = 7 days.
AUTH_REFRESH_TOKEN_TTL_HOURS=168
# Absolute session cap in hours: even with sliding refresh, re-login is forced after this. 720 = 30 days.
AUTH_ABSOLUTE_SESSION_TTL_HOURS=720
AUTH_STORAGE=postgres   
AUTH_ACCESS_COOKIE_NAME=apant_access
AUTH_REFRESH_COOKIE_NAME=apant_refresh
AUTH_CSRF_COOKIE_NAME=apant_csrf
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false

REPORT_STORAGE=postgres
SCAN_STORAGE=postgres

DB_HOST=postgres
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=apant_be3
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta



SCANNER_BASE_URL=http://scanner:8081
# Keep above the scanner per-tool timeout (300s) and its WriteTimeout (360s) so a
# slow tool (e.g. sqlmap) times out cleanly instead of dropping the connection.
SCANNER_TIMEOUT_SECONDS=420
NMAP_TIMEOUT_SECONDS=60
# Wall-clock budget for a whole background (dynamic) scan, in minutes. Raise this
# if scans hit "scan timed out" before finishing their step budget. Default 30.
SCAN_MAX_MINUTES=30
LAB_ONLY_MODE=true

DOCKER_BINARY=docker

# DEPRECATED (no longer read): per-1M-token prices used to be configured here as a
# single global pair. Cost is now a per-model property — set each model's price via
# the admin LLM provider/model API, and it is frozen onto each scan record at scan
# start. These env vars are ignored; kept here only to document the migration.
# LLM_PRICE_IN_PER_1M=
# LLM_PRICE_OUT_PER_1M=
# LLM_PRICE_CURRENCY=USD

# Per-call HTTP timeout for LLM providers, in whole seconds (default 120). Raise
# it for slow endpoints/models — requests are non-streaming, so the server must
# finish generating the whole answer before it responds; a large agentic prompt
# on a slow or reasoning model (e.g. deepseek-reasoner) can exceed the default and
# fail with "Client.Timeout exceeded while awaiting headers".
LLM_HTTP_TIMEOUT_SECONDS=120