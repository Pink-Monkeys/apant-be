        <mxCell id="dyn_e30" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="g8" target="g9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="dyn_e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="g9" target="g10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
