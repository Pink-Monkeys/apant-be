        <mxCell id="reg_panel" value="&lt;b&gt;Deskripsi Activity Diagram: Register&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester)&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Membuat akun baru (role default: pentester) dan langsung menerbitkan sesi.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User mengisi username, email, dan password lalu submit.&lt;br&gt;2. Sistem memvalidasi format: username (3-32, a-z0-9_.-), email valid, password 8-72 karakter mengandung huruf dan angka.&lt;br&gt;3. Sistem memeriksa apakah username/email sudah dipakai.&lt;br&gt;4. Sistem meng-hash password (bcrypt) dan menyimpan user baru dengan role pentester.&lt;br&gt;5. Sistem menerbitkan pasangan token dan menyetel cookie auth (201 Created).&lt;br&gt;6. User masuk ke dashboard.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 2a. Format tidak valid: sistem mengembalikan error 400.&lt;br&gt;- 3a. Username/email sudah dipakai: sistem mengembalikan error 409 (Conflict).&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="415" as="geometry"/></mxCell>
        <mxCell id="L_reg" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="800" as="geometry"/></mxCell>
        <mxCell id="R_reg" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="800" as="geometry"/></mxCell>
