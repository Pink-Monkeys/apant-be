        <mxCell id="out_panel" value="&lt;b&gt;Deskripsi Activity Diagram: Logout&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester)&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Mengakhiri sesi dengan mencabut refresh token dan menghapus cookie.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User menekan Logout; request membawa cookie/JWT.&lt;br&gt;2. Sistem memvalidasi klaim JWT.&lt;br&gt;3. Sistem mencabut (revoke) seluruh refresh token milik user.&lt;br&gt;4. Sistem menghapus cookie autentikasi dan mengembalikan status sukses.&lt;br&gt;5. User diarahkan ke halaman login.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 2a. Klaim JWT tidak valid: sistem mengembalikan error 401.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="347" as="geometry"/></mxCell>
        <mxCell id="L_out" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="560" as="geometry"/></mxCell>
        <mxCell id="R_out" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="560" as="geometry"/></mxCell>
