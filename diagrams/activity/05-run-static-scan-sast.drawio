        <mxCell id="sast_e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="join" target="u3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="1440"/><mxPoint x="190" y="1327"/></Array></mxGeometry></mxCell>
        <mxCell id="sast_panel" value="&lt;b&gt;Deskripsi Activity Diagram: Run Static Scan (SAST)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester); internal: LLM &amp; tools SAST&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Menganalisis source code (SAST) dari arsip ZIP secara agentik dan asinkron.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User memilih file source (.zip), provider/model, dan deskripsi lalu mengunggah.&lt;br&gt;2. Sistem memastikan file ada &amp; berekstensi .zip, menyimpan ke temp, memvalidasi provider/model, dan memastikan tidak ada scan berjalan.&lt;br&gt;3. Sistem menyimpan scan running, membuat scan_id, mengembalikannya (202). Proses berjalan asinkron (fork).&lt;br&gt;4. Alur User: polling GET /scans/:id secara berkala.&lt;br&gt;5. Alur Sistem (background): mengekstrak ZIP ke workspace dengan batas jumlah file &amp; ukuran.&lt;br&gt;6. Loop triage: LLM memilih tool SAST (semgrep_scan, gitleaks_scan, osv_scan, list_files, read_file, grep_code); tiap eksekusi mencatat temuan.&lt;br&gt;7. Loop berulang hingga final/max_steps/batal, lalu sistem menyusun temuan + rekomendasi remediasi.&lt;br&gt;8. Sistem menyimpan status terminal, menghapus temp &amp; workspace; bila completed membuat laporan SAST otomatis.&lt;br&gt;9. User melihat hasil scan dan laporan.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 2a. File bukan .zip / tidak ada, atau sudah ada scan berjalan: error (400/409).&lt;br&gt;- 5a. Arsip tidak valid saat ekstraksi: scan gagal (failed) dan workspace dibersihkan.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="568" as="geometry"/></mxCell>
        <mxCell id="L_sast" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="1440" as="geometry"/></mxCell>
        <mxCell id="R_sast" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="1440" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
