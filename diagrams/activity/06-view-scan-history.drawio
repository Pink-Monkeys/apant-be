        <mxCell id="hist_panel" value="&lt;b&gt;Deskripsi Activity Diagram: View Scan History&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester) / Admin&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Menampilkan daftar scan dan detailnya sesuai hak akses.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User membuka halaman Scan History.&lt;br&gt;2. Sistem mengautentikasi (middleware JWT).&lt;br&gt;3. Bila admin, sistem mengambil seluruh scan; bila pentester, hanya scan miliknya. Daftar dikembalikan.&lt;br&gt;4. User memilih satu scan.&lt;br&gt;5. Sistem mengambil detail via GET /scans/:id dengan pengecekan kepemilikan (admin atau pemilik).&lt;br&gt;6. Sistem mengembalikan detail scan (langkah, temuan); user melihat detail.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 5a. Bukan admin dan bukan pemilik: sistem mengembalikan error 403 (akses ditolak).&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="381" as="geometry"/></mxCell>
        <mxCell id="L_hist" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="760" as="geometry"/></mxCell>
        <mxCell id="R_hist" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="760" as="geometry"/></mxCell>
