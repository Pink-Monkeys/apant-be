        <mxCell id="sllm_panel" value="&lt;b&gt;Deskripsi Activity Diagram: Select LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester)&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Memilih provider &amp; model LLM yang dipakai untuk scan berikutnya (per-user).&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User membuka pengaturan model.&lt;br&gt;2. Sistem mengautentikasi dan mengambil opsi LLM (provider &amp; model aktif) beserta seleksi saat ini.&lt;br&gt;3. User memilih provider &amp; model lalu menyimpan.&lt;br&gt;4. Sistem memvalidasi ketersediaan provider &amp; model.&lt;br&gt;5. Sistem menyimpan seleksi milik user (scoped ke identitas user) dan mengembalikannya.&lt;br&gt;6. Seleksi tersimpan dan dipakai pada scan berikutnya.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 4a. Provider/model tidak tersedia: sistem mengembalikan error.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="364" as="geometry"/></mxCell>
        <mxCell id="L_sllm" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="700" as="geometry"/></mxCell>
        <mxCell id="R_sllm" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="700" as="geometry"/></mxCell>
