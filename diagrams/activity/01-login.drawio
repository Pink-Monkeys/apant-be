        <mxCell id="login_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="k" target="l"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="login_panel" value="&lt;b&gt;Deskripsi Activity Diagram: Login&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Aktor:&lt;/b&gt; User (Pentester)&lt;br&gt;&lt;b&gt;Tujuan:&lt;/b&gt; Mengautentikasi pengguna dan menerbitkan sesi (JWT + refresh token).&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Utama:&lt;/b&gt;&lt;br&gt;1. User membuka halaman login dan mengisi username/email serta password.&lt;br&gt;2. User menekan tombol submit.&lt;br&gt;3. Sistem memvalidasi kelengkapan input.&lt;br&gt;4. Sistem mencari user berdasarkan username/email lalu memverifikasi password dengan bcrypt.&lt;br&gt;5. Bila kredensial valid, sistem menerbitkan access token (JWT) dan refresh token.&lt;br&gt;6. Sistem menyetel cookie autentikasi (access, refresh, CSRF) dan mengembalikan data user.&lt;br&gt;7. User diarahkan ke dashboard.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alur Alternatif / Pengecualian:&lt;/b&gt;&lt;br&gt;- 3a. Input tidak lengkap: sistem mengembalikan error 400.&lt;br&gt;- 4a. User tidak ditemukan atau password salah: sistem mengembalikan 401 (invalid credentials).&lt;br&gt;- Sistem menampilkan pesan error dan proses berhenti.&lt;br&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=#FCFCFC;strokeColor=#90A4AE;fontSize=11;spacingLeft=10;spacingRight=10;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="760" y="50" width="440" height="449" as="geometry"/></mxCell>
        <mxCell id="L_login" value="User (Pentester)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#E3F2FD;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="300" height="700" as="geometry"/></mxCell>
        <mxCell id="R_login" value="Sistem (APANT Backend)" style="swimlane;html=1;startSize=30;horizontal=1;fontSize=13;fontStyle=1;rounded=0;swimlaneFillColor=#F1F8E9;fillColor=#F1F8E9;strokeColor=#2E7D32;strokeWidth=2;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="360" height="700" as="geometry"/></mxCell>
